<!DOCTYPE html>
<html lang="fr">
  <head>
    <%- include('../partials/head', { title: title }) %>
  </head>
  <body>
    <%- include('../partials/navbar'); %>
    <main class="page-shell">
      <div class="container">
        <section class="data-card fade-up">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
              <h1 class="section-title mb-1"><%= title %></h1>
              <p class="text-muted mb-0">Liste des formateurs et specialites.</p>
            </div>
            <a href="/formateurs/ajouter" class="btn btn-brand">Ajouter un formateur</a>
          </div>

          <div class="table-responsive">
            <table class="table table-borderless align-middle">
              <thead>
                <tr>
                  <th>Id</th>
                  <th>Utilisateur</th>
                  <th>Specialite</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody id="formateursTable"></tbody>
            </table>
          </div>
        </section>
      </div>
    </main>
    <%- include('../partials/footer'); %>

    <script>
      async function fetchFormateurs() {
        try {
          const [formateursRes, usersRes] = await Promise.all([
            fetch('/api/formateurs'),
            fetch('/api/users')
          ]);
          const formateursData = await formateursRes.json();
          const usersData = await usersRes.json();
          if (!formateursData.success) throw new Error(formateursData.message);
          if (!usersData.success) throw new Error(usersData.message);

          const userMap = new Map(usersData.users.map(user => [user.id, `${user.prenom || ''} ${user.nom || ''}`.trim()]));
          const tbody = document.getElementById('formateursTable');
          tbody.innerHTML = '';

          formateursData.formateurs.forEach(f => {
            const row = document.createElement('tr');
            row.innerHTML = `
              <td>${f.id}</td>
              <td>${userMap.get(f.user_id) || f.user_id || ''}</td>
              <td>${f.specialite || ''}</td>
              <td class="text-end">
                <a href="/formateurs/modifier/${f.id}" class="btn btn-sm btn-outline-brand">Modifier</a>
                <button class="btn btn-sm btn-outline-danger ms-2" onclick="supprimer('${f.id}')">Supprimer</button>
              </td>
            `;
            tbody.appendChild(row);
          });
        } catch (err) {
          console.error('Erreur API :', err);
          alert(err.message);
        }
      }

      async function supprimer(id) {
        if (!confirm('Voulez-vous vraiment supprimer ce formateur ?')) return;
        try {
          const res = await fetch(`/api/formateurs/${id}`, { method: 'DELETE' });
          const data = await res.json();
          if (!data.success) throw new Error(data.message);
          fetchFormateurs();
        } catch (err) {
          alert('Erreur : ' + err.message);
        }
      }

      fetchFormateurs();
    </script>
  </body>
</html>
