<!DOCTYPE html>
<html lang="fr">
  <head>
    <%- include('partials/head', { title: 'Erreur' }) %>
  </head>
  <body>
    <%- include('partials/navbar'); %>
    <main class="page-shell">
      <div class="container">
        <section class="data-card">
          <h1 class="section-title">Une erreur est survenue</h1>
          <p class="text-muted mb-4"><%= message %></p>
          <% if (error && error.status) { %>
            <span class="chip">Code <%= error.status %></span>
          <% } %>
          <div class="mt-4">
            <a class="btn btn-brand" href="/">Retour a l'accueil</a>
          </div>
        </section>
      </div>
    </main>
    <%- include('partials/footer'); %>
  </body>
</html>
