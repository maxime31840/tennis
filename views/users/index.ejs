<!DOCTYPE html>
<html lang="fr">
  <head>
    <%- include('../partials/head', { title: title }) %>
  </head>
  <body>
    <%- include('../partials/navbar'); %>
    <main class="page-shell">
      <div class="container">
        <section class="data-card fade-up">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
              <h1 class="section-title mb-1"><%= title %></h1>
              <p class="text-muted mb-0">Gerer les comptes et les roles internes.</p>
            </div>
            <a href="/users/ajouter" class="btn btn-brand">Ajouter un utilisateur</a>
          </div>

          <div class="table-responsive">
            <table class="table table-borderless align-middle">
              <thead>
                <tr>
                  <th>Id</th>
                  <th>Nom</th>
                  <th>Prenom</th>
                  <th>Email</th>
                  <th>Role</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody id="usersTable"></tbody>
            </table>
          </div>
        </section>
      </div>
    </main>
    <%- include('../partials/footer'); %>

    <script>
      async function fetchUsers() {
        try {
          const res = await fetch('/api/users');
          const data = await res.json();
          if (!data.success) throw new Error(data.message);

          const tbody = document.getElementById('usersTable');
          tbody.innerHTML = '';

          data.users.forEach(user => {
            const row = document.createElement('tr');
            row.innerHTML = `
              <td>${user.id}</td>
              <td>${user.nom || ''}</td>
              <td>${user.prenom || ''}</td>
              <td>${user.email || ''}</td>
              <td><span class="chip">${user.role || ''}</span></td>
              <td class="text-end">
                <a href="/users/modifier/${user.id}" class="btn btn-sm btn-outline-brand">Modifier</a>
                <button class="btn btn-sm btn-outline-danger ms-2" onclick="supprimer('${user.id}')">Supprimer</button>
              </td>
            `;
            tbody.appendChild(row);
          });
        } catch (err) {
          console.error('Erreur API :', err);
          alert(err.message);
        }
      }

      async function supprimer(id) {
        if (!confirm('Voulez-vous vraiment supprimer cet utilisateur ?')) return;
        try {
          const res = await fetch(`/api/user/${id}`, { method: 'DELETE' });
          const data = await res.json();
          if (!data.success) throw new Error(data.message);
          fetchUsers();
        } catch (err) {
          alert('Erreur : ' + err.message);
        }
      }

      fetchUsers();
    </script>
  </body>
</html>
